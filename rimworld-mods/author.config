# Who the mods say they are by. Edit, then run: python3 tools/apply_author.py
#
# author:          shown in RimWorld's mod list. Any text.
# package_prefix:  first part of every packageId (prefix.ModName). Letters and
#                  digits only. Changing it after release breaks players' mod
#                  lists and saves, because RimWorld identifies a mod by packageId.
author = Unnamed Modder
package_prefix = unnamed
