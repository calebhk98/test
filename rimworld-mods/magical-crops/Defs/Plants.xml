<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="PlantBase">
    <defName>MC_Plant_HealrootPlus</defName>
    <label>healroot+</label>
    <description>An improved strain of healroot. Slower to grow than the wild kind, but each plant gives more herbal medicine.</description>
    <graphicData>
      <texPath>MagicalCrops/Plants/HealrootPlus</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>85</MaxHitPoints>
      <Beauty>0</Beauty>
    </statBases>
    <plant>
      <fertilityMin>0.5</fertilityMin>
      <fertilitySensitivity>0.4</fertilitySensitivity>
      <growDays>9</growDays>
      <sowMinSkill>8</sowMinSkill>
      <harvestWork>170</harvestWork>
      <harvestedThingDef>MedicineHerbal</harvestedThingDef><harvestYield>11</harvestYield>
      <sowTags>
        <li>Ground</li>
        <li>Hydroponic</li>
      </sowTags>
      <sowResearchPrerequisites>
        <li>MC_MagicalBotany</li>
      </sowResearchPrerequisites>
      <visualSizeRange>0.5~1.0</visualSizeRange>
      <purpose>Misc</purpose>
      
    </plant>
  </ThingDef>
  <ThingDef ParentName="PlantBase">
    <defName>MC_Plant_MoodBloom</defName>
    <label>mood bloom</label>
    <description>Showy blue flowers. Colonists who walk among a field of them feel better. Harvest gives nothing, it is just for looks.</description>
    <graphicData>
      <texPath>MagicalCrops/Plants/MoodBloom</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>85</MaxHitPoints>
      <Beauty>4</Beauty>
    </statBases>
    <plant>
      <fertilityMin>0.5</fertilityMin>
      <fertilitySensitivity>0.4</fertilitySensitivity>
      <growDays>6</growDays>
      <sowMinSkill>4</sowMinSkill>
      <harvestWork>100</harvestWork>
      
      <sowTags>
        <li>Ground</li>
        <li>Hydroponic</li>
      </sowTags>
      <sowResearchPrerequisites>
        <li>MC_MagicalBotany</li>
      </sowResearchPrerequisites>
      <visualSizeRange>0.5~1.0</visualSizeRange>
      <purpose>Misc</purpose>
      
    </plant>
  </ThingDef>
  <ThingDef ParentName="PlantBase">
    <defName>MC_Plant_SteelVine</defName>
    <label>steel vine</label>
    <description>A grey vine with metallic leaves that draws steel out of the soil. Very slow, so mining is still faster.</description>
    <graphicData>
      <texPath>MagicalCrops/Plants/SteelVine</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>85</MaxHitPoints>
      <Beauty>0</Beauty>
    </statBases>
    <plant>
      <fertilityMin>0.5</fertilityMin>
      <fertilitySensitivity>0.4</fertilitySensitivity>
      <growDays>30</growDays>
      <sowMinSkill>8</sowMinSkill>
      <harvestWork>250</harvestWork>
      <harvestedThingDef>Steel</harvestedThingDef><harvestYield>5</harvestYield>
      <sowTags>
        <li>Ground</li>
        <li>Hydroponic</li>
      </sowTags>
      <sowResearchPrerequisites>
        <li>MC_MagicalBotany</li>
      </sowResearchPrerequisites>
      <visualSizeRange>0.5~1.0</visualSizeRange>
      <purpose>Misc</purpose>
      
    </plant>
  </ThingDef>
  <ThingDef ParentName="PlantBase">
    <defName>MC_Plant_StoneGourd</defName>
    <label>stone gourd</label>
    <description>A heavy gourd that grows a shell of granite. Slow, but gives stone blocks to a colony with no rock.</description>
    <graphicData>
      <texPath>MagicalCrops/Plants/StoneGourd</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>85</MaxHitPoints>
      <Beauty>0</Beauty>
    </statBases>
    <plant>
      <fertilityMin>0.5</fertilityMin>
      <fertilitySensitivity>0.4</fertilitySensitivity>
      <growDays>22</growDays>
      <sowMinSkill>6</sowMinSkill>
      <harvestWork>220</harvestWork>
      <harvestedThingDef>BlocksGranite</harvestedThingDef><harvestYield>8</harvestYield>
      <sowTags>
        <li>Ground</li>
        <li>Hydroponic</li>
      </sowTags>
