  <ThingDef ParentName="PlantBase">
    <defName>MC_Plant_GlowCap</defName>
    <label>glow cap</label>
    <description>A mushroom that glows softly. Grows in the dark and lights its own farm.</description>
    <graphicData>
      <texPath>MagicalCrops/Plants/GlowCap</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>85</MaxHitPoints>
      <Beauty>1</Beauty>
    </statBases>
    <comps>
      <li Class="CompProperties_Glower"><glowRadius>5</glowRadius><glowColor>(60,200,150,0)</glowColor></li>
    </comps>
    <plant>
      <fertilityMin>0.5</fertilityMin>
      <fertilitySensitivity>0.4</fertilitySensitivity>
      <growDays>12</growDays>
      <sowMinSkill>5</sowMinSkill>
      <harvestWork>120</harvestWork>
      <harvestedThingDef>MC_ManaBean</harvestedThingDef><harvestYield>1</harvestYield>
      <sowTags>
        <li>Ground</li>
        <li>Hydroponic</li>
      </sowTags>
      <sowResearchPrerequisites>
        <li>MC_MagicalBotany</li>
      </sowResearchPrerequisites>
      <visualSizeRange>0.5~1.0</visualSizeRange>
      <purpose>Misc</purpose>
      <growMinGlow>0</growMinGlow><growOptimalGlow>0.2</growOptimalGlow><dieIfNoSunlight>false</dieIfNoSunlight>
    </plant>
  </ThingDef>
  <ThingDef ParentName="PlantBase">
    <defName>MC_Plant_HeatPepper</defName>
