<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <StorytellerDef>
    <defName>SH_TheHundred</defName>
    <label>The Hundred</label>
    <description>Wants exactly one thing: a hundred colonists under your roof. Sends wanderers, refugees and visitors at a steady pace until you get there, and sizes the threats for the crowd you already have. Past the target, the pace settles down.</description>
    <listOrder>1000</listOrder>
    <portraitLarge>UI/Storyteller/TheHundredLarge</portraitLarge>
    <portraitTiny>UI/Storyteller/TheHundredTiny</portraitTiny>

    <!-- Population intent stays high until 100, then drops below zero. -->
    <populationIntentFactorFromPopCurve>
      <points>
        <li>(0, 8)</li>
        <li>(30, 6)</li>
        <li>(70, 4)</li>
        <li>(99, 3)</li>
        <li>(100, 0)</li>
        <li>(110, -1)</li>
      </points>
    </populationIntentFactorFromPopCurve>
    <populationIntentFactorFromPopAdaptDaysCurve>
      <points>
        <li>(0, 1)</li>
        <li>(100, 1)</li>
      </points>
    </populationIntentFactorFromPopAdaptDaysCurve>

    <pointsFactorFromDaysPassed>
      <points>
        <li>(0, 0.4)</li>
        <li>(8, 0.7)</li>
        <li>(30, 1)</li>
      </points>
    </pointsFactorFromDaysPassed>
    <adaptDaysMin>0</adaptDaysMin>
    <adaptDaysMax>40</adaptDaysMax>
    <adaptDaysGameStartGraceDays>8</adaptDaysGameStartGraceDays>
    <adaptDaysGrowthRateCurve>
      <points>
        <li>(0, 1)</li>
        <li>(100, 1)</li>
      </points>
    </adaptDaysGrowthRateCurve>
    <pointsFactorFromAdaptDays>
      <points>
        <li>(0, 1)</li>
        <li>(40, 1.2)</li>
      </points>
    </pointsFactorFromAdaptDays>

    <comps>
      <!-- Threats. Points come from the game's normal colony-size and wealth scaling. -->
      <li Class="StorytellerCompProperties_OnOffCycle">
        <category>ThreatBig</category>
        <minDaysPassed>8</minDaysPassed>
        <onDays>4</onDays>
        <offDays>6</offDays>
        <minSpacingDays>1.5</minSpacingDays>
        <numIncidentsRange>1~2</numIncidentsRange>
        <forceRaidEnemyBeforeDaysPassed>20</forceRaidEnemyBeforeDaysPassed>
        <acceptFractionByDaysPassedCurve>
          <points>
            <li>(8, 0)</li>
            <li>(20, 1)</li>
          </points>
        </acceptFractionByDaysPassedCurve>
      </li>
      <li Class="StorytellerCompProperties_RandomMain">
        <minDaysPassed>4</minDaysPassed>
        <mtbDays>1.5</mtbDays>
        <maxThreatBigIntervalDays>15</maxThreatBigIntervalDays>
        <categoryWeights>
          <li><category>ThreatSmall</category><weight>2</weight></li>
          <li><category>Misc</category><weight>3</weight></li>
        </categoryWeights>
      </li>
      <li Class="StorytellerCompProperties_Disease">
        <category>DiseaseHuman</category>
        <minDaysPassed>12</minDaysPassed>
      </li>
      <li Class="StorytellerCompProperties_FactionInteraction">
        <incident>VisitorGroup</incident>
        <baseIncidentsPerYear>6</baseIncidentsPerYear>
        <minSpacingDays>3</minSpacingDays>
        <fullAlliesOnly>false</fullAlliesOnly>
      </li>
      <li Class="StorytellerCompProperties_FactionInteraction">
        <incident>TraderCaravanArrival</incident>
        <baseIncidentsPerYear>8</baseIncidentsPerYear>
        <minSpacingDays>3</minSpacingDays>
        <fullAlliesOnly>false</fullAlliesOnly>
      </li>
      <li Class="StorytellerCompProperties_RandomQuest">
        <category>GiveQuest</category>
        <minDaysPassed>5</minDaysPassed>
        <onDays>8</onDays>
        <offDays>4</offDays>
        <minSpacingDays>3</minSpacingDays>
        <numIncidentsRange>1~1</numIncidentsRange>
      </li>

      <!-- Recruiting. Own comp, see Source. Rate and target are mod settings. -->
      <li Class="StorytellerHundred.StorytellerCompProperties_Arrivals">
        <minDaysPassed>1</minDaysPassed>
        <mtbDays>2.5</mtbDays>
        <incidents>
          <li>WandererJoin</li>
          <li>RefugeePodCrash</li>
        </incidents>
      </li>
    </comps>
  </StorytellerDef>

</Defs>
