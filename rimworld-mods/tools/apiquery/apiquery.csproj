<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.1" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" GeneratePathProperty="true" ExcludeAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <RimRefDir>$(PkgKrafs_Rimworld_Ref)/ref/net472</RimRefDir>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RimRefDir</_Parameter1>
      <_Parameter2>$(RimRefDir)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
