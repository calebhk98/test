# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required: MarketCheck API key (free tier) — https://www.marketcheck.com/apis
MARKETCHECK_API_KEY=your_marketcheck_key_here

# Optional: Discord webhook for the daily digest message
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# Optional: bearer token required by the JSON API / website (blank = no auth, localhost only)
CARMON_API_TOKEN=

# No key is needed for NHTSA (api.nhtsa.gov) or EPA fueleconomy.gov — both are free,
# public, keyless APIs. Nothing to configure here for them; see config.json -> enrichment.

# --- Discord: pick ONE transport -------------------------------------------------
# (a) Direct message — the digest arrives in your DMs, not a server channel.
#     Create a bot at https://discord.com/developers/applications -> Bot -> Reset Token.
#     Discord only allows bots to DM users who share a server with them, so also create a
#     private server, invite the bot, and keep "Allow direct messages from server members" on.
#     Your user id: Discord Settings -> Advanced -> Developer Mode, then right-click your
#     name -> Copy User ID.
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=
