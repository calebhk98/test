# Copy to .env and adjust as needed.

NODE_ENV=development

# Postgres connection used by src/db/pool.ts and scripts/pg-dev.sh.
# Default matches scripts/pg-dev.sh (port 55433, db "outcome_dating").
DATABASE_URL=postgres://outcome_dating@127.0.0.1:55433/outcome_dating

# Local dev Postgres cluster settings (scripts/pg-dev.sh).
PGDATA_DIR=.pgdata
PGPORT=55433

HTTP_PORT=3000
HTTP_HOST=0.0.0.0

# HMAC secret for auth tokens and voucher QR payloads (src/lib/signing.ts).
# MUST be overridden in real environments.
AUTH_TOKEN_SECRET=dev-insecure-secret-change-me

# Access token lifetime, minutes.
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh token lifetime, days.
REFRESH_TOKEN_TTL_DAYS=30

# Which PaymentProcessor adapter to use: "fake" or "stripe".
PAYMENT_PROCESSOR=fake

# Only used when PAYMENT_PROCESSOR=stripe (see src/services/payments/stripe.processor.ts).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
